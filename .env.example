# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. The .env file is loaded
# automatically by `config.py` via python-dotenv.
# ---------------------------------------------------------------------------

# --- Target Goethe-Institut booking endpoint -------------------------------
# TODO: replace with the *exact* page or JSON endpoint you want to monitor
GOETHE_TARGET_URL=https://www.goethe.de/ins/xx/xx/spr/prf/REPLACE_ME.html

# --- Telegram alerts (optional) --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rotating residential proxy pool ---------------------------------------
# Either set a single rotating gateway URL ...
PROXY_GATEWAY=
# ... or supply a comma-separated list of proxies that will be rotated on
# each scan. Both http and socks5 are supported by httpx.
# Example: http://user:pass@host1:port,http://user:pass@host2:port
PROXY_LIST=
