# =========================================================================
# Goethe Sniper – Environment Configuration
# Copy this file to `.env` and fill in your real values.
# =========================================================================

# -------------------------------------------------------------------------
# TARGET ENDPOINT
# Replace with the exact Goethe-Institut booking page / JSON endpoint
# you want the Scanner to poll.
#   e.g.  https://www.goethe.de/ins/eg/de/spr/prf/gzb1.cfm
#   or    https://www.goethe.de/coe/appointments?examId=...
# -------------------------------------------------------------------------
TARGET_URL=https://www.goethe.de/ins/CHANGE-ME/spr/prf/gzb1.cfm

# -------------------------------------------------------------------------
# SCANNER TUNING
# -------------------------------------------------------------------------
SCAN_INTERVAL_MIN=15
SCAN_INTERVAL_MAX=30

# Text that is present ONLY when there are NO slots.
# As soon as this string disappears from the page (or a positive marker
# appears) the Sniper is triggered.
NEGATIVE_MARKER=Keine Buchung möglich
POSITIVE_MARKER=Anmelden

# -------------------------------------------------------------------------
# ROTATING RESIDENTIAL PROXY (placeholder)
# Format: http://USER:PASS@gateway.provider.com:PORT
# Leave empty to scan without proxy.
# -------------------------------------------------------------------------
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_HOST=
PROXY_PORT=

# -------------------------------------------------------------------------
# TELEGRAM ALERTS (placeholder – fill once you create a bot)
# -------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------------------------------------------------------------------------
# CLIENT DATA
# -------------------------------------------------------------------------
CLIENT_FILE=client.json
